# Database
DATABASE_URL=postgresql://oss_tips:oss_tips_dev@localhost:5432/oss_tips

# Web
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
AUTH_DEV_MODE=true
# Required in production; used only for keyed audit IP hashes.
AUDIT_HASH_SECRET=change-me-in-production

# Optional OAuth (omit to disable that provider)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# Codeberg uses Better Auth generic OAuth; register /api/auth/callback/codeberg as redirect URI.
# CODEBERG_CLIENT_ID=
# CODEBERG_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Object storage (RustFS / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=OSS_TIPS_DEV
S3_SECRET_ACCESS_KEY=oss_tips_dev_secret_change_me
# Non-image uploads require a reachable ClamAV daemon before promotion.
# Required in production; leave unset locally when testing image-only flows.
# MALWARE_SCANNER_HOST=clamav
# MALWARE_SCANNER_PORT=3310
# MALWARE_SCANNER_TIMEOUT_MS=15000

# Ledger
# Local-only default. Production must use LEDGER_MODE=tigerbeetle.
LEDGER_MODE=mock
TIGERBEETLE_ADDRESSES=
TIGERBEETLE_CLUSTER_ID=

# Workers
WORKER_POLL_MS=2000
# Comma-separated queues consumed by general worker.
WORKER_QUEUE=default,exports,domains
FINANCE_WORKER_POLL_MS=1000
FINANCE_WORKER_BATCH_SIZE=10

# Discord bot
DISCORD_BOT_TOKEN=
# Optional gateway endpoint override; production must use wss://.
# DISCORD_GATEWAY_URL=wss://gateway.discord.gg/?v=10&encoding=json
# Web Discord OAuth token envelope key. Required when Discord linking is enabled
# in production; keep separate from WEBHOOK_ENCRYPTION_KEY.
DISCORD_TOKEN_ENCRYPTION_KEY=

# Email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=oss.tips <noreply@oss.tips>

# API/webhook security
# Base64/base64url or 64-character hex key encoding 32 random bytes.
WEBHOOK_ENCRYPTION_KEY=
# Dedicated HMAC key for durable API rate-limit principals.
API_RATE_LIMIT_SECRET=

# Observability
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10000
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# Required by infra/docker/docker-compose.production.yml. Keep values in the
# deployment secret store, never in this file.
MAPLE_OTLP_ENDPOINT=
MAPLE_OTLP_TOKEN=
