{
  "name": "@oss-tips/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node --import tsx src/migrate.ts",
    "seed": "node --import tsx src/seed.ts"
  },
  "dependencies": {
    "@oss-tips/domain": "workspace:*",
    "kysely": "^0.29.5",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
