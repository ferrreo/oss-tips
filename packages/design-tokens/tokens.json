{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "oss.tips Paperlight",
    "version": "1.0.0",
    "sourceLocale": "en-GB"
  },
  "colour": {
    "light": {
      "canvas": "#FBF7EF",
      "canvasSubtle": "#F5EFE4",
      "surface": "#FFFDF8",
      "surfaceRaised": "#F4EEDF",
      "ink": "#1E2A22",
      "inkMuted": "#5C665B",
      "inkFaint": "#61685F",
      "forest": "#2D5C3A",
      "forestHover": "#244A30",
      "moss": "#7C8A5B",
      "fern": "#A8B59A",
      "ochre": "#B88747",
      "border": "#DDD5C6",
      "borderStrong": "#918878",
      "success": "#2F6A41",
      "warning": "#9A651F",
      "danger": "#A3463C",
      "info": "#366A76",
      "focus": "#2D5C3A",
      "overlay": "rgba(30,42,34,.46)"
    },
    "dark": {
      "canvas": "#11130F",
      "canvasSubtle": "#151813",
      "surface": "#171A15",
      "surfaceRaised": "#1D211B",
      "ink": "#EDE7D8",
      "inkMuted": "#B4B1A3",
      "inkFaint": "#8E9084",
      "forest": "#91A66E",
      "forestHover": "#A5BA82",
      "moss": "#71834F",
      "fern": "#4D5E3C",
      "ochre": "#C6A36B",
      "border": "#34382E",
      "borderStrong": "#626858",
      "success": "#A5C87D",
      "warning": "#D8B06C",
      "danger": "#D47A6E",
      "info": "#8AADA6",
      "focus": "#B5CF8D",
      "overlay": "rgba(0,0,0,.64)"
    }
  },
  "typography": {
    "displayFamily": "Newsreader, 'EB Garamond', Georgia, serif",
    "uiFamily": "'Source Sans 3', Inter, system-ui, sans-serif",
    "monoFamily": "'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.25rem",
      "4xl": "3.25rem",
      "5xl": "4.5rem"
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "0.875rem",
    "xl": "1.25rem",
    "round": "9999px"
  },
  "shadow": {
    "light": "0 1px 2px rgba(30,42,34,.06), 0 12px 32px rgba(30,42,34,.07)",
    "dark": "0 1px 2px rgba(0,0,0,.32), 0 16px 40px rgba(0,0,0,.22)"
  },
  "motion": {
    "instant": "80ms",
    "fast": "140ms",
    "normal": "220ms",
    "slow": "360ms",
    "reduced": "0.01ms",
    "easeStandard": "cubic-bezier(.2,.8,.2,1)",
    "easeOut": "cubic-bezier(.16,1,.3,1)",
    "easeIn": "cubic-bezier(.7,0,.84,0)"
  },
  "layout": {
    "contentMax": "80rem",
    "readingMax": "70ch",
    "dashboardMax": "96rem",
    "sidebar": "16rem",
    "touchTarget": "2.75rem"
  }
}
