{
  "name": "@oss-tips/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./src/content/markdown.ts",
      "svelte": "./src/content/markdown.ts",
      "default": "./dist/content/markdown.js"
    },
    "./money": {
      "types": "./src/money/index.ts",
      "svelte": "./src/money/index.ts",
      "default": "./dist/money/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./auth-otp": {
      "types": "./dist/auth-otp.d.ts",
      "default": "./dist/auth-otp.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
