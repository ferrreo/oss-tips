FROM node:22-bookworm-slim AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV CI=true
ARG APP_FILTER
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r --workspace-concurrency=1 --filter="${APP_FILTER}..." exec tsc -b tsconfig.json --force
RUN pnpm --filter "${APP_FILTER}" exec tsc -b tsconfig.json --force
RUN pnpm deploy --legacy --filter "${APP_FILTER}" --prod /prod

FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build --chown=node:node /prod ./
USER node

ENTRYPOINT ["node", "--import", "@oss-tips/observability/register"]
CMD ["dist/index.js"]
