FROM node:22-bookworm-slim AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV CI=true
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN pnpm deploy --legacy --filter @oss-tips/web --prod /prod
RUN cp -R apps/web/build /prod/build
RUN rm -rf /prod/src /prod/static /prod/.svelte-kit /prod/vite.config.ts /prod/svelte.config.js /prod/tsconfig.json

FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
WORKDIR /app

COPY --from=build --chown=node:node /prod ./
USER node

EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 CMD node -e "fetch('http://127.0.0.1:3000/readyz').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1))"
ENTRYPOINT ["node", "--import", "@oss-tips/observability/register"]
CMD ["build"]
